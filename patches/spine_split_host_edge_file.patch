+static std::vector<PartitionedCsrEdgeRef> load_edge_file(
+    const std::string &path
+) {
+    std::ifstream input(path);
+    if (!input) {
+        throw std::runtime_error("failed to open edge file: " + path);
+    }
+
+    std::vector<PartitionedCsrEdgeRef> edges;
+    std::string line;
+    size_t line_no = 0;
+    while (std::getline(input, line)) {
+        line_no++;
+        size_t comment = line.find('#');
+        if (comment != std::string::npos) {
+            line.resize(comment);
+        }
+
+        std::istringstream iss(line);
+        uint64_t src = 0;
+        uint64_t dst = 0;
+        uint64_t weight = 1;
+        int64_t diff = 1;
+        if (!(iss >> src)) {
+            continue;
+        }
+        if (!(iss >> dst)) {
+            throw std::runtime_error("edge file missing dst at line " +
+                                     std::to_string(line_no));
+        }
+        if (!(iss >> weight)) {
+            weight = 1;
+        }
+        if (!(iss >> diff)) {
+            diff = 1;
+        }
+
+        std::string extra;
+        if (iss >> extra) {
+            throw std::runtime_error("edge file has extra token at line " +
+                                     std::to_string(line_no));
+        }
+        if (src >= (uint64_t)MAX_N || dst >= (uint64_t)MAX_N) {
+            throw std::runtime_error("edge file vertex id exceeds MAX_N at line " +
+                                     std::to_string(line_no));
+        }
+        if (weight > (uint64_t)std::numeric_limits<uint16_t>::max()) {
+            throw std::runtime_error("edge file weight exceeds uint16 at line " +
+                                     std::to_string(line_no));
+        }
+        if (diff < (int64_t)std::numeric_limits<int16_t>::min() ||
+            diff > (int64_t)std::numeric_limits<int16_t>::max()) {
+            throw std::runtime_error("edge file diff exceeds int16 at line " +
+                                     std::to_string(line_no));
+        }
+
+        edges.push_back({(uint32_t)src, (uint32_t)dst,
+                         (uint16_t)weight, (int16_t)diff});
+        if (edges.size() > (size_t)HOST_PARTITIONED_RATIO2_MAX_SORT_N) {
+            throw std::runtime_error("edge file exceeds one-batch MAX_SORT_N");
+        }
+    }
+
+    if (edges.empty()) {
+        throw std::runtime_error("edge file contains no edges: " + path);
+    }
+    return edges;
+}
